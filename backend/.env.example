# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/angel-fashion-studio

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d
COOKIE_EXPIRE=7

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_CURRENCY=aud

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_FOLDER=angel-fashion-studio

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://angelfashionstudio.au,https://*.netlify.app

# Firebase project id (public) — verifies customer ID tokens on order routes
FIREBASE_PROJECT_ID=your-firebase-project-id
